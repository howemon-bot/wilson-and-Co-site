# SiteGround runs Apache — this file ships with every deploy.
RewriteEngine On

# Force HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Old WordPress URLs -> sections of the new page
RewriteRule ^projects/?$ /#projects [NE,R=301,L]
RewriteRule ^our_services/?$ /#services [NE,R=301,L]
RewriteRule ^contact-us/?$ /#contact [NE,R=301,L]

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml
</IfModule>

# Cache hashed build assets for a year, keep HTML fresh
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
</IfModule>
